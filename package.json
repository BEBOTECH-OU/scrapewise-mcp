{
  "name": "scrapewise-mcp",
  "version": "0.1.3",
  "private": true,
  "description": "ScrapeWise MCP over stdio: a thin local bridge to the hosted server at https://mcp.scrapewise.ai/mcp. Lists the tools without a key; running a tool needs SCRAPEWISE_API_KEY.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "scrapewise-mcp": "stdio/server.mjs"
  },
  "files": [
    "stdio/server.mjs",
    "stdio/tools.snapshot.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node stdio/server.mjs",
    "test": "node stdio/smoke.mjs",
    "refresh-snapshot": "node stdio/refresh-snapshot.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
